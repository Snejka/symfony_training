{% extends 'base.html.twig' %}

{% block title %}Hello FirstturboController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <turbo-frame id="turbo_frame_1">
        <section>
            <h1>Content Loaded on click</h1>
            The content of this block will replace the content of the Turbo Frame!
            The rest of the HTML generated by this template (outside of the Turbo Frame) will be ignored.
        </section>
    </turbo-frame>

    <turbo-frame id="turbo_frame_2">
        <section>
            <h1>Lazy Loaded Section</h1>
            The content of this block will replace the content of the Turbo Frame!
            The rest of the HTML generated by this template (outside of the Turbo Frame) will be ignored.
        </section>
    </turbo-frame>
    
{% endblock %}
