{# Injects our file inside the base.html #}
{% extends 'base.html.twig' %}

{# Gets the text and load it as page title #}
{% block title %}Hello HomeController!{% endblock %}

{# Define the body section and load it as body in base.html.twig #}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
{# controller_name and param are set in HomeControler File #}
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from :
    <p>{{ param }}</p>
    <ul>
        <li>Your controller at <code>C:/Users/Snejka/Desktop/symfony_training/src/Controller/HomeController.php</code></li>
        <li>Your template at <code>C:/Users/Snejka/Desktop/symfony_training/templates/home/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
